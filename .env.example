# Review Scraper & Analyzer Agent Configuration

# Remote LLM API Keys (at least one required for AI-powered analysis)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# OR use Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OR use a local LLM via Ollama (supports Gemma, Llama, Mistral, etc.)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=gemma3:12b

# If no LLM is configured, the agent falls back to keyword-based analysis.
